# Docker Compose only (PostgreSQL)
# Copy this file to the repository root as .env before running Docker Compose.
# Docker Compose sets the database engine, host, port, and application roles.

DJANGO_SECRET_KEY=replace-with-a-secret-value
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

DJANGO_DB_PASSWORD=change-me
DJANGO_DB_READONLY_PASSWORD=change-me
POSTGRES_PASSWORD=change-me
GUNICORN_WORKERS=4

# Optional Docker Compose overrides
# DJANGO_DB_NAME=app
# DJANGO_DB_USER=app_write
# DJANGO_DB_READONLY_USER=app_readonly
