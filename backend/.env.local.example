# Local development only (SQLite)
# Copy this file to backend/.env.
# SQLite uses its default database path and requires no database variables.

DJANGO_SECRET_KEY=replace-with-a-local-secret-value
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
